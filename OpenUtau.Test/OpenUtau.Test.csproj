<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Avalonia.Headless.XUnit 12.1.2 / 12.1.3 are built against xunit.v3 3.x and
         call TestIntrospectionHelper.GetTestCaseDetails, whose signature changed in xunit.v3
         4.0.0. On 4.0.0 every [AvaloniaFact] fails during discovery with MissingMethodException
         (AvaloniaUI/Avalonia#22072: xunit v3 4.0 is unsupported). Upstream ships no
         [AvaloniaFact] tests, so its own suite does not hit this. Pin xunit.v3 / .common /
         .extensibility.core to 3.2.2 (the last 3.x stable) until Avalonia releases a headless
         adapter for xunit.v3 4.x; 12.1.3 still depends on xunit.v3.extensibility.core 3.2.2.
         xunit.runner.visualstudio stays at the upstream 4.0.0: it is VSTest-only, is not used
         by the Microsoft.Testing.Platform path, and has no 3.x release. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.v3.common" Version="3.2.2" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
    <ProjectReference Include="..\OpenUtau.Plugin.Builtin\OpenUtau.Plugin.Builtin.csproj" />
    <ProjectReference Include="..\OpenUtau\OpenUtau.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Usts\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Usts\" />
    <None Include="Files\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Files\" />
  </ItemGroup>
</Project>
