<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             xmlns:c="using:OpenUtau.App.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600" Width="400"
             x:Class="OpenUtau.App.Controls.NotePropertiesControl"
             x:DataType="vm:NotePropertiesViewModel"
             KeyDown="OnKeyDown" Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button,CheckBox,ComboBox">
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Label,TextBox,Slider,ComboBox,CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider.fader">
      <Setter Property="Focusable" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <TextBlock Text="{Binding Title}" Height="24" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    <ScrollViewer Margin="0,48,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
      <StackPanel Margin="0">
        <Expander Header="{DynamicResource noteproperty.basic}" HorizontalAlignment="Stretch" Margin="0,0,4,2">
          <StackPanel IsEnabled="{Binding IsNoteSelected}">
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource notedefaults.lyric}" Grid.Column="0"/>
              <TextBox Text="{Binding Lyric, Mode=OneWay}" Grid.Column="1" Tag="Lyric"/>
            </Grid>

            <!-- to be updated later to use the same categ phonemizer -->
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.phonemizer}" Grid.Column="0"/>
              <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2"
                      Content="{Binding PhonemizerOverrideText}"
                      Click="OnPhonemizerButtonClicked">
                <Button.ContextMenu>
                  <ContextMenu Name="PhonemizerMenu" ItemsSource="{Binding PhonemizerMenuItems}" Placement="Left">
                    <ContextMenu.Styles>
                      <Style Selector="MenuItem" x:DataType="vm:MenuItemViewModel">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command, FallbackValue={x:Null}}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="ItemsSource" Value="{Binding Items}"/>
                      </Style>
                    </ContextMenu.Styles>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.tone}" Grid.Column="0"/>
              <TextBox Text="{Binding Tone, Mode=OneWay}" Grid.Column="1" Tag="Tone" Margin="0"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource noteproperty.tuning}" FontWeight="{Binding TuningFontWeight}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding Tuning}" Minimum="-100" Maximum="100" TickFrequency="1"
                                 Tag="Tuning"/>
            </Grid>
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.pre}"/>
              <TextBox Grid.Column="1" Text="{Binding PhonemePre, Mode=OneWay}" Tag="PhonemePre" Margin="0"/>
            </Grid>
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.overlap}"/>
              <TextBox Grid.Column="1" Text="{Binding PhonemeOverlap, Mode=OneWay}" Tag="PhonemeOverlap" Margin="0"/>
            </Grid>
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.attack}"/>
              <TextBox Grid.Column="1" Text="{Binding PhonemeAttack, Mode=OneWay}" Tag="PhonemeAttack" Margin="0"/>
            </Grid>
            <Grid ColumnDefinitions="143,*">
              <Label Content="{DynamicResource noteproperty.release}"/>
              <TextBox Grid.Column="1" Text="{Binding PhonemeRelease, Mode=OneWay}" Tag="PhonemeRelease" Margin="0"/>
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource notedefaults.portamento}" HorizontalAlignment="Stretch" Margin="0,2,4,2">
          <StackPanel IsEnabled="{Binding IsNoteSelected}">
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource notedefaults.preset}"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding PortamentoPresets}" Margin="0"
                SelectedItem="{Binding ApplyPortamentoPreset}" HorizontalAlignment="Stretch"/>
            </Grid>
            <Grid ColumnDefinitions="123,20,*,20,*">
              <Button Grid.Column="2" Content="{DynamicResource button.save}"
                      HorizontalAlignment="Stretch" Click="OnSavePortamentoPreset"
                      ToolTip.Tip="{DynamicResource notedefaults.preset.save.tooltip}"/>
              <Button Grid.Column="4" Content="{DynamicResource button.remove}"
                      HorizontalAlignment="Stretch" Command="{Binding RemoveAppliedPortamentoPreset}"
                      ToolTip.Tip="{DynamicResource notedefaults.preset.remove.tooltip}"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.portamento.length}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding PortamentoLength}" Minimum="2" Maximum="320" TickFrequency="1"
                                 Tag="PortamentoLength"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.portamento.start}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding PortamentoStart}" Minimum="-200" Maximum="200" TickFrequency="1"
                                 Tag="PortamentoStart"/>
            </Grid>
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource context.pitch.shape}"/>
              <ComboBox Grid.Column="2" Margin="0" SelectedIndex="{Binding PitchCurveShape}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{DynamicResource context.pitch.easeinout}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.linear}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.easein}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.easeout}"/>
                <ComboBoxItem Content="{DynamicResource context.pitch.smooth}"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource notedefaults.vibrato}" HorizontalAlignment="Stretch" Margin="0,2,4,2">
          <StackPanel IsEnabled="{Binding IsNoteSelected}">
            <ToggleSwitch IsChecked="{Binding VibratoEnable, Mode=OneWay}" OnContent="{DynamicResource button.on}" OffContent="{DynamicResource button.off}"
                          Click="VibratoEnableClicked"/>
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource notedefaults.preset}"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding VibratoPresets}" Margin="0"
                SelectedItem="{Binding ApplyVibratoPreset}" HorizontalAlignment="Stretch" />
            </Grid>
            <Grid ColumnDefinitions="123,20,*,20,*">
              <Button Grid.Column="2" Content="{DynamicResource button.save}"
                      HorizontalAlignment="Stretch" Click="OnSaveVibratoPreset"
                      ToolTip.Tip="{DynamicResource notedefaults.preset.save.tooltip}"/>
              <Button Grid.Column="4" Content="{DynamicResource button.remove}"
                HorizontalAlignment="Stretch" Command="{Binding RemoveAppliedVibratoPreset}"
                ToolTip.Tip="{DynamicResource notedefaults.preset.remove.tooltip}"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*" >
              <Label Content="{DynamicResource notedefaults.vibrato.length}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoLength}" Minimum="0" Maximum="100" TickFrequency="0.1"
                                 Tag="VibratoLength"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.period}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoPeriod}" Minimum="5" Maximum="500" TickFrequency="0.1"
                                 Tag="VibratoPeriod"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.depth}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoDepth}" Minimum="5" Maximum="200" TickFrequency="0.1"
                                 Tag="VibratoDepth"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.in}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoIn}" Minimum="0" Maximum="100" TickFrequency="0.1"
                                 Tag="VibratoIn"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.out}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoOut}" Minimum="0" Maximum="100" TickFrequency="0.1"
                                 Tag="VibratoOut"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.shift}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoShift}" Minimum="0" Maximum="100" TickFrequency="0.1"
                                 Tag="VibratoShift"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.drift}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoDrift}" Minimum="-100" Maximum="100" TickFrequency="0.1"
                                 Tag="VibratoDrift"/>
            </Grid>
            <Grid ColumnDefinitions="130,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.vollink}"/>
              <c:UnboundedSlider Grid.Column="2" Value="{Binding VibratoVolLink}" Minimum="-100" Maximum="100" TickFrequency="0.1"
                                 Tag="VibratoVolLink"/>
            </Grid>
            <Grid ColumnDefinitions="123,20,*">
              <Label Content="{DynamicResource noteproperty.setlongnote}"/>
              <CheckBox Grid.Column="2" IsChecked="{Binding AutoVibratoToggle}"/>
            </Grid>
            <Grid ColumnDefinitions="180,8,*">
              <Label Content="{DynamicResource notedefaults.vibrato.autominlength}"/>
              <c:UnboundedSlider Grid.Column="2" IsEnabled="{Binding AutoVibratoToggle}" Value="{Binding AutoVibratoNoteLength}" Minimum="10" Maximum="1920" TickFrequency="1"/>
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource exps.caption}" HorizontalAlignment="Stretch" Margin="0,2,4,0">
          <StackPanel Name="ExpressionsPanel" />
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
